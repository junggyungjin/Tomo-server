// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
  DELETED
}

enum RoomStatus {
  OPEN
  CLOSED
}

model User {
  id          String   @id @default(uuid()) // PK (UUID)
  provider    String                       // 가입 경로(소셜로그인)
  providerId  String                        // 해당 소셜 플랫폼에서 넘겨주는 유저의 고유 식별값
  email       String?                       // 이메일 (소셜 간 이메일 중복 허용)
  nickname    String?                        // 닉네임 (닉네임은 앱 특성상 중복 가능)
  handle      String   @unique              // 다른 유저가 검색할때 고유 핸들
  nationality String?
  gender      String?
  profileImageUrl String?
  status      UserStatus @default(PENDING)
  createdAt   DateTime @default(now())      // 가입일 (자동 생성)
  updatedAt   DateTime @updatedAt
  refreshTokens   RefreshToken[]
  feed        Feed[]
  @@unique([provider, providerId])
}

model RefreshToken {
  id     String   @id @default(uuid())
  token  String   @unique @db.Text
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  deviceInfo  String?                   // 접속 환경 식별용
  createdAt   DateTime   @default(now())
  @@index([userId]) 
}

model Feed {
  id         String     @id @default(uuid())
  content    String?    // 글 내용 (사진만 올릴 수도 있으므로 optional)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  callRoom   CallRoom?  // 1:1 관계 (선택적 통화방)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CallRoom {
  id                   String       @id @default(uuid())
  feedId               String       @unique // Feed와의 1:1관계를 위한 unique 외래키
  status               RoomStatus   @default(OPEN)  // 상태 : OPEN, CLOSED 등
  maxParicipants       Int          @default(4)    // 최대인원 : 4
  currentParticipants  Int          @default(1)  // 현재인원 (방장 포함이므로 기본값 1)
  feed                 Feed         @relation(fields: [feedId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
}